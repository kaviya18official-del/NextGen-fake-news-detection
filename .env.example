# NextGen NewsVerify — Environment Configuration Example
# Copy this file to '.env' and populate with your credentials.

# Google Fact Check Tools API Key
# Sign up and obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# Database URL (Defaults to local SQLite data/newsverify.db if left unset)
DATABASE_URL=sqlite:///data/newsverify.db

# Path to Tesseract OCR executable (Optional: only needed if tesseract is not on system PATH)
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Example Linux: /usr/bin/tesseract
TESSERACT_CMD=

# Disable SQLAlchemy C Extensions for Windows WDAC policy compliance
DISABLE_SQLALCHEMY_CEXT=1
